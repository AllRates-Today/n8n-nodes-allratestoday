{
	"name": "n8n-nodes-allratestoday",
	"version": "0.1.1",
	"description": "n8n community node for AllRatesToday: official central-bank exchange rates (keyless, 120+ sources) and real-time market rates with conversion",
	"license": "MIT",
	"homepage": "https://allratestoday.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"exchange-rates",
		"exchange rates",
		"currency",
		"forex",
		"fx",
		"central-bank",
		"ecb",
		"currency-converter",
		"api"
	],
	"author": {
		"name": "AllRatesToday",
		"url": "https://allratestoday.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/AllRates-Today/n8n-nodes-allratestoday.git"
	},
	"bugs": {
		"url": "https://github.com/AllRates-Today/n8n-nodes-allratestoday/issues"
	},
	"engines": {
		"node": ">=18.10"
	},
	"scripts": {
		"build": "rimraf dist && tsc && node scripts/copy-icons.mjs",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials package.json",
		"lintfix": "eslint nodes credentials package.json --fix",
		"prepublishOnly": "npm run build && npm run lint"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/AllRatesTodayApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AllRatesToday/AllRatesToday.node.js"
		]
	},
	"devDependencies": {
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^8.57.0",
		"eslint-plugin-n8n-nodes-base": "^1.16.3",
		"n8n-workflow": "*",
		"prettier": "^3.3.0",
		"rimraf": "^5.0.0",
		"typescript": "^5.5.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
